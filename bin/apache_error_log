#!/usr/bin/perl

# A more user-friendly version of:
#       tail -f /var/log/httpd/ssl_error_log

use strict;
use warnings;

use English;
use Term::ANSIColor;

use Data::Dumper;


############################################
## Figure out which files we want to monitor
############################################
my @log_dirs = ("/var/log/httpd/", "/var/log/apache2/");
my ($log_dir) = grep { -d } @log_dirs;
if (! -d $log_dir) {
    die "Log directories (" . join(", ", @log_dirs) . ") not found or are unreadable.\n";
}
#die "\$log_dir = $log_dir\n";

my @files_monitored = 
        grep { -r && -T }
            map { glob $_ }
                ("$log_dir/*error_log", "$log_dir/error.log*");
#die Dumper \@files_monitored;
if (! @files_monitored) {
    die "No Apache log files found under $log_dir, or you don't have permissions to read them.\n";
}

# Show the most-recently-updated file matches last.
@files_monitored = sort { -M $b <=> -M $a } @files_monitored;


#################################
## Process command-line arguments
#################################
if (! @ARGV) {
    die "$0:  A regex must be specified. I suggest using the name of the script you're debugging, or perhaps just 'wsgi'.\n";
}
my $regex = shift @ARGV;


##################
## Main event loop
##################
open my $fh_tail, '-|',
        'tail', '-f', '-q', @files_monitored
    or die $!;

while (<$fh_tail>) {
    chomp;
    my $orig_line = $_;
    my $parsed = parse_Apache_error_log($_);
    #print "$_\n", Dumper($parsed), "\n";
    if ($orig_line =~ /$regex/o) {
        # Hilight regex matches using Term::ANSIColor.
        my $display = $parsed->{log_message};
        $display =~ s/($regex)/ colored($1, "white on_red") /oge;

        print "$display\n";
    }
}




# TODO: Is there an existing module that does this parsing okay?
#
# Input arguments:  One text line.
# Returns:  A hash-ref.
sub parse_Apache_error_log {
    my ($line) = @_;
    my %parsed;

    chomp $line;

    if ($line =~ s/^\[([^\]]*)\] //) {
        $parsed{timestamp} = $1;
    } else {
        return \%parsed;
    }

    if ($line =~ s/^\[([^\]]*)\] //) {
        my ($module, $level) = split ':', $1;
        $parsed{level_module} = $module;
        $parsed{level}        = $level;
    } else {
        return \%parsed;
    }

    if ($line =~ s/^\[(pid [^\]]*)\] //) {
        $parsed{pid} = $1;
    } else {
        return \%parsed;
    }

    if ($line =~ s/^\[client ([^\]]*)\] //) {
        $parsed{client} = $1;
    } else {
        return \%parsed;
    }

    if ($parsed{level_module} eq 'cgid') {
        $line =~ s/: (\S+)$//;
        $parsed{cgi_script} = $1;
    }

    $line =~ s/^\s*//;
    if ($line =~ /\S/) {
        $parsed{log_message} = $line;
    }

    return \%parsed;
}
